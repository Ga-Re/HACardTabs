  "description": "Home Assistant Lovelace card with configurable tabs – every tab is a section that holds other cards.",
  "type": "module",
  "main": "dist/hacardtabs.js",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c --watch",
