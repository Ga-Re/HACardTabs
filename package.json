  ],
  "license": "MIT",
  "dependencies": {
    "lit": "^3.3.0"
  },
  "devDependencies": {
    "@mdi/js": "^7.4.47",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^1.0.0",
    "http-server": "^14.1.1",
    "rollup": "^4.40.0"
  }
}
